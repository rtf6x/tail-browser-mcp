{
  "manifest_version": 3,
  "name": "Tail MCP (Chrome)",
  "version": "2.0.10",
  "description": "Local MCP server control for Chrome. Open extension options after install for setup steps.",
  "homepage_url": "https://github.com/rtf6x/tail-browser-mcp",
  "permissions": ["tabs", "tabGroups", "history", "storage", "scripting", "alarms", "offscreen", "debugger"],
  "icons": {
    "16": "assets/icons/disconnected-16.png",
    "32": "assets/icons/disconnected-32.png",
    "48": "assets/icons/disconnected-48.png",
    "128": "assets/icons/disconnected-128.png"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "Tail MCP — MCP server offline",
    "default_icon": {
      "16": "assets/icons/disconnected-16.png",
      "32": "assets/icons/disconnected-32.png",
      "48": "assets/icons/disconnected-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
