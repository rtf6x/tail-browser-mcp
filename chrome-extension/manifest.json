{
  "manifest_version": 3,
  "name": "Browser Control MCP (Chrome)",
  "version": "1.6.1",
  "description": "Local MCP server control for Chrome. Open extension options after install for setup steps.",
  "permissions": ["tabs", "tabGroups", "history", "storage", "scripting", "alarms", "offscreen"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "Browser Control MCP — MCP server offline",
    "default_icon": {
      "16": "assets/icons/disconnected-16.png",
      "32": "assets/icons/disconnected-32.png",
      "48": "assets/icons/disconnected-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
