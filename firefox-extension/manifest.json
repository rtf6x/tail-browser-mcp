{
    "manifest_version": 2,
    "name": "Tail MCP",
    "version": "2.0.6",
    "description": "Local MCP server control for Firefox. Open extension options after install for setup steps.",
    "homepage_url": "https://github.com/rtf6x/tail-browser-mcp",
    "browser_specific_settings": {
        "gecko": {
            "id": "tail-mcp@rtf6x.local",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "permissions": [
        "tabs",
        "tabGroups",
        "history",
        "storage"
    ],
    "optional_permissions": [
        "<all_urls>",
        "find"
    ],
    "background": {
      "scripts": ["dist/background.js"]
    },
    "options_ui": {
      "page": "options.html"
    }
  }
